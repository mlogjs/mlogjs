{
  "name": "mlogjs",
  "version": "0.5.2",
  "description": "Compiler that compiles Javascript to Mindustry Logic Code.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "bin": "./dist/bin.cjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf ../docs dist build",
    "build": "rollup -c",
    "build:dev": "rollup -c --environment DEV",
    "dev": "ts-node src/bin",
    "test": "jest",
    "coverage": "jest --coverage",
    "start": "pnpm run build && pnpm i -g . && mlogjs",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlogjs/mlogjs.git"
  },
  "keywords": [
    "mindustry",
    "mindustry-logic",
    "mlog"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mlogjs/mlogjs/issues"
  },
  "homepage": "https://github.com/mlogjs/mlogjs#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@babel/parser": "^7.22.7",
    "@babel/types": "^7.22.5",
    "chalk": "^4.1.2",
    "cli-highlight": "^2.1.11",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.24",
    "@types/yargs": "^17.0.24",
    "jest": "^30.2.0",
    "rollup": "^4.53.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tslib": "^2.6.2",
    "typescript": "*"
  },
  "files": [
    "build",
    "dist",
    "lib",
    "LICENSE",
    "README.md"
  ]
}
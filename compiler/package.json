{
  "name": "mlogjs",
  "version": "0.5.2",
  "description": "Compiler that compiles Javascript to Mindustry Logic Code.",
  "main": "./dist/index.mjs",
  "bin": "./dist/bin.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf ../docs dist build",
    "build": "rollup -c",
    "build:dev": "rollup -c --environment DEV",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlogjs/mlogjs.git"
  },
  "keywords": [
    "mindustry",
    "mindustry-logic",
    "mlog"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mlogjs/mlogjs/issues"
  },
  "homepage": "https://github.com/mlogjs/mlogjs#readme",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "dependencies": {
    "@babel/parser": "^8.0.8",
    "@babel/types": "^8.0.8",
    "chalk": "^6.0.1",
    "cli-highlight": "^2.1.11",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/yargs": "^17.0.35",
    "rollup": "^4.65.0",
    "tslib": "^2.6.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "files": [
    "build",
    "dist",
    "lib",
    "LICENSE",
    "README.md"
  ]
}
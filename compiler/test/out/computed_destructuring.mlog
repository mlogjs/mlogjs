set &t0->0 5
set &t0->1 4
set &t0->2 3
set &t0->3 2
set &t0->4 1
print "calculating 1\n"
set &t0:calculate:7:0 1
set a:1:22 null
jump 14 lessThan &t0:calculate:7:0 0
jump 14 greaterThan &t0:calculate:7:0 4
set &t0.&rt 13
op mul &t1 &t0:calculate:7:0 2
op add @counter 36 &t1
set a:1:22 &t0.&read
op strictEqual &t2 a:1:22 null
jump 18 equal &t2 0
print "calculating 2\n"
set a:1:22 2
print "calculating 3\n"
set &t1:calculate:7:0 3
set b:1:56 null
jump 27 lessThan &t1:calculate:7:0 0
jump 27 greaterThan &t1:calculate:7:0 4
set &t0.&rt 26
op mul &t3 &t1:calculate:7:0 2
op add @counter 36 &t3
set b:1:56 &t0.&read
op strictEqual &t4 b:1:56 null
jump 31 equal &t4 0
print "calculating 4\n"
set b:1:56 4
print "a: {0}, b: {0}"
format a:1:22
format b:1:56
printflush message1
end
set &t0.&read &t0->0
set @counter &t0.&rt
set &t0.&read &t0->1
set @counter &t0.&rt
set &t0.&read &t0->2
set @counter &t0.&rt
set &t0.&read &t0->3
set @counter &t0.&rt
set &t0.&read &t0->4
set @counter &t0.&rt

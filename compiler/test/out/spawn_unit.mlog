ubind @gamma
sensor shootX:5:8 @unit @shootX
sensor shootY:5:16 @unit @shootY
sensor shooting:5:24 @unit @shooting
jump 6 notEqual shooting:5:24 0
end
spawn @eclipse shootX:5:8 shootY:5:16 0 @malis unit:9:6 true
spawn @flare shootX:5:8 shootY:5:16 0 @sharded silentUnit:16:6 0
sensor &t0 unit:9:6 @health
sensor &t1 silentUnit:16:6 @health
print "available health: {0} {0}"
format &t0
format &t1
printflush message1

{
  "workspaces": [
    "website",
    "compiler"
  ],
  "scripts": {
    "lint": "eslint .",
    "check-formatting": "prettier --check ."
  },
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "prettier": "^3.0.0",
    "prettier-plugin-jsdoc": "^1.0.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.46.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@algolia/client-search",
        "search-insights"
      ]
    },
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "vue-demi"
    ]
  }
}
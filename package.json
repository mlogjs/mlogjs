{
  "workspaces": [
    "website",
    "compiler"
  ],
  "scripts": {
    "lint": "eslint .",
    "check-formatting": "prettier --check ."
  },
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-jsdoc": "^1.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@algolia/client-search",
        "search-insights"
      ]
    },
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "rollup",
      "vue-demi"
    ]
  }
}
